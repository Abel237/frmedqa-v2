# Copy to <project>/.env and fill in. Never commit .env (it is in .gitignore).
# Plain KEY=value lines; the job scripts load them with `set -a`.

# ── Hugging Face (models, datasets, adapter uploads) ──
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Weights & Biases (optional; leave empty to disable) ──
WANDB_API_KEY=

# ── Email updates ──
MAIL_TO=413374@edu.itmo.ru          # where updates go (change if you prefer another address)
# SMTP account used to SEND the mails (works even if the cluster has no mail server).
# Example with Gmail: create an "App password" (Google account > Security > App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.address@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx
MAIL_FROM=
HEARTBEAT_HOURS=6                    # progress mail every N hours while a job runs
STALL_HOURS=3                        # warn if a job's log has not changed for N hours

# ── Pipeline ──
SEEDS="42 43 44"                     # SFT / evaluation / analysis seeds (CPT runs once)
FRMEDQA_PROFILE=full                 # full-scale settings (colab = the reduced Colab settings)
FRMEDQA_TOKEN_BUDGET_M="250,80,40"   # CPT budgets in millions of tokens: FR-bio, EN-bio, general
CONDA_SH=/mnt/tank/scratch/dbrice/miniconda3/etc/profile.d/conda.sh
CONDA_ENV=frmedqa-v2
KERNEL=frmedqa-v2
